[Unit]
Description=Mutno 2027 FastAPI
After=network.target

[Service]
Type=simple
User=mutno
Group=mutno
WorkingDirectory=/opt/mutno_2027
ExecStart=/opt/mutno_2027/.venv/bin/python -m uvicorn app_final:app --host 127.0.0.1 --port 8017 --no-access-log
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
Environment=PYTHONDONTWRITEBYTECODE=1

[Install]
WantedBy=multi-user.target
